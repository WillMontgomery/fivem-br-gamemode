## FiveM Royale -- server configuration
##
## Target: Legacy FiveM (standard FXServer Linux artifacts), Ubuntu.
## See DEPLOY.md for the full setup walkthrough.
##
## Two things in here are load-bearing and easy to get wrong, so they are called
## out at the top:
##
##   1. The default `chat` resource is NOT started. This gamemode ships its own
##      chat in br_ui, and two chat systems fighting over the T key is a bad
##      time. If you see a duplicate chat box, something re-enabled it.
##
##   2. spawnmanager and basic-gamemode are NOT started. They would spawn players
##      into the world on join and respawn them on death, both of which the match
##      state machine owns. Leaving them on produces players appearing at random
##      map locations mid-match.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
endpoint_add_tcp "0.0.0.0:30120"
endpoint_add_udp "0.0.0.0:30120"

# ---------------------------------------------------------------------------
# Players and sync
# ---------------------------------------------------------------------------

# OneSync is required: this gamemode's roster, storm damage and validation all
# run server-side against every connected player.
set onesync on

# 48 is the FREE OneSync ceiling. Going above it requires a Cfx.re Element Club
# tier (Argentum 64 / Arum 128 / Platinum 2048) attached to your license key --
# and setting it higher WITHOUT one makes the server fail its heartbeat check and
# disappear from the public list entirely. Raise Config.Match.maxPlayers in
# br_lib/config/match.lua to match if you ever change this.
sv_maxclients 48

# Sync rate. 60 is a sensible default; raise only if 48-player load testing shows
# sync lag, and expect CPU cost to scale roughly linearly.
set sv_syncTickRate 60

sv_scriptHookAllowed 0
sv_enforceGameBuild 3095

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
sv_hostname "FiveM Royale | Battle Royale"
sets sv_projectName "FiveM Royale"
sets sv_projectDesc "48-player battle royale. Drop, loot, outlast the storm."
sets locale "en-US"
sets tags "battle royale, br, pvp, gamemode"

# Get one from https://keymaster.fivem.net -- the server will not start without it.
sv_licenseKey "CHANGEME"

# ---------------------------------------------------------------------------
# Admin permissions
#
# Most br_* commands are registered restricted, so they need this ACE from a live
# client. Typed at the server console they always work, because console commands
# run as source 0.
#
# Replace the identifier with your own license: find it with `brroster` or in the
# server log on join.
# ---------------------------------------------------------------------------
add_ace group.admin br.admin allow
add_ace group.admin command allow
# add_principal identifier.license:PUT_YOUR_LICENSE_HERE group.admin

# ---------------------------------------------------------------------------
# Base resources
#
# Deliberately minimal. Anything that spawns, respawns, or moves a player
# conflicts with the match state machine.
# ---------------------------------------------------------------------------
ensure sessionmanager    # connection handling -- required
ensure hardcap           # enforces sv_maxclients

# VOICE. THIRD-PARTY, NOT IN THIS REPOSITORY, AND YOU MUST INSTALL IT YOURSELF.
# See the "Voice" block further down for the exact commands -- this one line is
# the whole of the config, but the resource has to be on the box first.
#
# Started BEFORE br_core so the proximity rules land on a resource that is
# already up. br_core does not require that -- it re-states them if pma-voice
# starts later, and it boots without it -- but there is no reason to make it
# work for a living.
ensure pma-voice

# NOT started, on purpose:
#   chat            -- br_ui provides chat; two systems fight over the T key
#   spawnmanager    -- br_core owns spawning and the warmup pad
#   basic-gamemode  -- would respawn players into the world on death
#   mapmanager      -- nothing to load; we use the vanilla map as-is

# ---------------------------------------------------------------------------
# Gamemode
#
# ORDER MATTERS.
#   br_lib   is a file container with no runtime scripts, but must exist and be
#            started before anything referencing '@br_lib/...' loads.
#   br_core  defines the loop registry and scheduler.
#   br_ui    owns the NUI page and NUI focus.
#   br_stats is last; it is the only optional one.
# ---------------------------------------------------------------------------
ensure br_lib
ensure br_core
ensure br_environment    # world state: IPLs + the Cayo Perico lobby island
ensure br_ui
ensure br_loadscreen     # branded loading screen; br_core releases it
ensure br_ddb            # DynamoDB: ban checks, grants, and stats persistence
ensure br_stats          # match results + XP, written through br_ddb
ensure br_ringmaster     # optional -- the admin console's game-side half

# ---------------------------------------------------------------------------
# Ringmaster (M9). ALL OPTIONAL. With none of these set, br_ringmaster boots,
# says it is off in one line, and does nothing for the rest of the run.
#
# The endpoint is a PRIVATE address reached over the VPC peering link. It must
# never be a public hostname and never go through Cloudflare -- if you find
# yourself typing a domain here, something is wrong with the network setup.
#
# The secret is a real credential. server.cfg is gitignored precisely so lines
# like this one can exist; do not move it into server.cfg.example.
# ---------------------------------------------------------------------------
# set br_ringmaster_ingest_url    "http://10.0.0.10:3000/api/ingest"
# set br_ringmaster_ingest_secret "<generate with: openssl rand -hex 24>"
# set br_ringmaster_push_ms       2000
#
# (The angle brackets above are not decoration -- tools/check_secrets.sh treats
#  them as a placeholder marker. Without them this line reads as a committed
#  credential and fails the build, which is exactly what it should do to a real
#  one. It caught this very line when it was first written.)

# ---------------------------------------------------------------------------
# br_ddb (M9 Slice 2). ALSO OPTIONAL, and NOT A CREDENTIAL in sight -- the SDK
# finds the EC2 instance role through instance metadata on its own. If you ever
# feel the need to put an access key here, the role is wrong.
#
# Both have working defaults; set them only if your tables live elsewhere.
# `brddb` in the server console proves the box can actually reach DynamoDB.
# ---------------------------------------------------------------------------
# set br_ddb_region       "us-east-2"
# set br_ddb_table_prefix "ringmaster-"

# ---------------------------------------------------------------------------
# VOICE. THE RESOURCE IS NOT IN THIS REPOSITORY. INSTALL IT ON THE BOX.
#
# The gamemode no longer drives FiveM's Mumble natives itself. It drives
# pma-voice (MIT, (c) Dillon Skaggs), which owns proximity and the squad radio;
# br_core only tells it our rules. Six rounds of hand-rolled voice preceded that
# decision and four of them shipped a silent 'nearby'.
#
# ---------------------------------------------------------------------------
# INSTALL, ONCE, ON THE SERVER. This is an operator step by design -- see WHY
# IT IS NOT VENDORED below. Run it as the user that owns the server directory:
#
#     cd /path/to/server-data/resources
#     mkdir -p '[voice]'
#     git clone --branch v7.0.0 --depth 1 \
#         https://github.com/AvarianKnight/pma-voice.git '[voice]/pma-voice'
#
# Then `ensure pma-voice` (already in the list above) and restart.
#
# THE PIN IS DELIBERATE. v7.0.0 is the latest tag that is not a release
# candidate; v7.0.1-rc2 and v7.0.2-rc3 exist and are not recommended for a live
# box. Every export br_core uses -- overrideProximityCheck,
# overrideProximityRange, setRadioChannel, addChannelCheck, setPlayerRadio,
# getMutedPlayers, toggleMutePlayer -- was verified present at v7.0.0. Upgrading
# is fine; upgrading blind is what the pin exists to stop.
#
# THE DIRECTORY MATTERS AND IT IS NOT ARBITRARY. `[voice]` is a sibling of
# `[gamemodes]`, and tools/deploy.sh rsyncs with --delete scoped to
# resources/[gamemodes]/[fivem-royale]/ ONLY. So pma-voice installed at
# resources/[voice]/pma-voice survives every deploy untouched. Install it
# INSIDE the gamemode tree instead and the next deploy will delete it.
#
# WHY IT IS NOT VENDORED INTO THIS REPOSITORY:
#   - It is ~400 KB of third-party Lua, JS and prebuilt UI that nobody on this
#     project has audited. Committing it means our pre-commit hook and
#     tools/check_secrets.sh sweep it forever, and it means we own its bugs.
#   - It has its own security and patch cadence. An operator should be able to
#     take a fix the day it lands without waiting for one of our releases.
#   - Nothing about the gamemode needs it in-tree: br_core detects it at
#     runtime with GetResourceState and boots without it.
# The trade is that a fresh box needs the clone above. That is one command, and
# a missing pma-voice announces itself in the server console on start and on the
# first line of `brvoice`.
#
# ---------------------------------------------------------------------------
# CONVARS. ONE IS REQUIRED. THE REST ARE OPTIONAL.
#
# REQUIRED -- turn pma-voice's own overlay off.
#
# This is the duplicate "currently talking" readout. The gamemode draws its own
# indicator (bottom centre, driven by br_core/client/voice.lua), and running
# both is the second contradicting voice this config already complains about
# elsewhere.
#
# WRITTEN DOWN BECAUSE THIS FILE PREVIOUSLY GOT IT WRONG IN BOTH DIRECTIONS. It
# was first recommended while no voice resource was installed, where it did
# nothing at all, and this file then said it "DOES NOTHING ON THIS SERVER" --
# true at the time, false the moment pma-voice is ensured. It is read in
# pma-voice's own client Lua in two places (client/init/init.lua, which sends
# `uiEnabled` to its NUI at start, and client/init/proximity.lua, which gates
# the talking/radio updates it pushes to that NUI), so 0 stops both the overlay
# and the traffic that feeds it.
setr voice_enableUi 0
#
# RECOMMENDED -- stop F11 cycling the proximity range.
#
# pma-voice ships three cycleable ranges (whisper/normal/shout) and a key to
# rotate them. This gamemode has ONE range, from Config.Match.voice.range.nearby.
# br_core already disables the cycle through the overrideProximityRange export;
# this is the belt to that braces, and it also removes the keybind from the
# player's key list so nobody goes looking for it.
setr voice_enableProximityCycle 0
#
# OPTIONAL -- native audio playback. STILL RECOMMENDED, STILL SECOND.
#
#   OFF (default, what you get if you leave this alone)
#     Voices are mixed by Mumble. Proximity still fades with distance -- that
#     is pma-voice's doing and it is the capability this whole change was made
#     to get -- but the sound is not placed in the world by the game engine.
#
#   ON
#     Playback is handed to GTA's own audio engine: occlusion, reverb, and a
#     voice that sounds like it is coming from where the player is standing.
#
#     ONE THING TO KNOW BEFORE YOU TURN IT ON. pma-voice multiplies its own
#     proximity range by three when this convar is set (client/init/proximity.lua).
#     br_core does NOT apply that multiplier -- our range is stated in world
#     metres and our proximity check compares metres -- so the CUTOFF does not
#     move when you flip this. What moves is how the last few metres sound.
#     (An earlier version of this note claimed the same outcome for the
#      hand-rolled system, which was true then for a different reason. It is
#      restated here because the reason changed and the conclusion did not.)
#
# TURN IT ON SECOND, after you have confirmed the range works. A hard edge is
# unambiguous; a fade and a broken cutoff can sound alike.
#
# setr voice_useNativeAudio true
#
# ---------------------------------------------------------------------------
# WHAT DOES *NOT* GO HERE.
#
# The proximity range itself. It is the gamemode's, from
# br_lib/config/match.lua (Config.Match.voice.range.nearby), pushed to each
# client and handed to pma-voice by br_core. Do not set voice_defaultVoiceMode
# or add voice modes -- br_core overrides the range on every match assignment
# and would overwrite you.
#
# The squad radio channel numbers. Also the gamemode's, derived from matchId and
# squadId in br_core/server/voice.lua, and gated by a pma-voice addChannelCheck
# so a client cannot join a squad it is not on.
#
# ---------------------------------------------------------------------------
# IF VOICE IS BROKEN, IN ORDER:
#
#   1. `brvoice` in the SERVER console. First line says whether pma-voice is
#      running at all. It lists squad radios only -- proximity is not assigned
#      by the server any more and cannot be diagnosed from there.
#   2. F8 `brvoice` on the affected CLIENT. First line, again, is the engine.
#      Then the "transmitting" line.
#   3. AND THIS IS THE PART THAT IS NEW: proximity is enforced by the SPEAKER.
#      If A cannot hear B, the machine to run /brvoice on is B'S, not A's.
#      There is nothing on A's client that can be refusing B.
# ---------------------------------------------------------------------------

# Our loading screen draws its own progress; the engine's busy spinner over
# it is just a second, contradicting voice.
setr sv_showBusySpinnerOnLoadingScreen false

# ---------------------------------------------------------------------------
# Third-party admin tools (vMenu etc.)
#
# If you run vMenu alongside this gamemode, DISABLE its overlapping features --
# the gamemode owns them and the two will fight:
#   - Player blips        (gamemode shows squadmates only)
#   - Overhead names      (gamemode shows squadmates only)
#   - Join/quit notifications (the gamemode hides GTA's feed entirely)
#   - PvP / friendly fire settings (the gamemode forces PvP on)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Development
#
# sv_devMode enables client dev tools and lowers the minimum players to start,
# so a match can be tested with two people instead of sixteen.
#
# TURN THIS OFF FOR PRODUCTION.
# ---------------------------------------------------------------------------
set sv_devMode true
set br_devMode true

# Useful console commands once running:
#   brhelp        list every server command
#   brstate       match state, counts, timers
#   brroster      every player the server knows about
#   brstorm       storm record + live containment check
#   brwhy <id>    why a given player is in the state they are in
#   brperf        scheduler cost per job
#   brdb          database health
#   brtop         leaderboard
#
# On a client, in the F8 console:
#   brnativecheck verify native assumptions against this build  <-- run this first
#   brdebug       on-screen overlay (perf / state / keys)
#   brperf        client loop cost per subsystem
