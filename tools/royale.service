# FiveM Royale -- systemd unit.
#
#   sudo cp tools/royale.service /etc/systemd/system/royale.service
#   sudo nano /etc/systemd/system/royale.service     # set User= and the paths
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now royale
#
# WHAT THIS FIXES. Until now the server was started by running a script in an
# interactive SSH session, which means it dies when that terminal dies and does
# not come back after a reboot. Under systemd it survives both, restarts itself
# if it crashes, and its output goes somewhere durable instead of scrollback.
#
# WHY STDIN IS HELD OPEN, AND WHY THAT IS THE WHOLE TRICK.
#
# Observed on this host 2026-08-09, and it is worth writing down because the
# symptom names a cause that is not the cause:
#
#     [ citizen-server-main] -> Quitting: Ctrl-C pressed in server console.
#     royale.service: Main process exited, code=exited, status=1/FAILURE
#
# Nobody pressed Ctrl-C. FXServer reads its console from stdin, and systemd
# hands a service a stdin that is immediately at end-of-file. FXServer reads
# that EOF and treats it as an interactive quit -- so it shuts down cleanly
# about two seconds into boot, every time, and Restart=always turns that into a
# tidy little boot loop.
#
# The community folklore for this is "recent artifacts segfault under systemd".
# On this host they do not segfault at all; they exit 0-ish and politely say
# why. Same fix either way: give the process a stdin that never reaches EOF.
# `< <(sleep infinity)` is that -- process substitution hands FXServer the read
# end of a pipe whose write end is held open by a sleeping child that never
# writes anything. The read blocks forever, no EOF ever arrives, and the server
# stays up.
#
# The cost: FXServer's console is now write-only. You can read it with
# journalctl and you cannot type into it. That is fine today (nothing needs to)
# and is exactly the gap M9's supervisor closes in Slice 2, by holding that
# pipe itself and being able to write down it.
#
# If this still will not stay up, tools/royale-tmux.service is the fallback --
# a pty keeps stdin open by a different route.

[Unit]
Description=FiveM Royale (FXServer)
Documentation=https://github.com/WillMontgomery/fivem-br-gamemode
After=network-online.target
Wants=network-online.target

# NO DATABASE DEPENDENCY, deliberately. There is no MariaDB ordering here even
# though br_stats can use one: nothing in the game reads it today, and M7b is
# moving persistence to DynamoDB entirely. `Wants=mariadb.service` would not
# merely order against it -- it would START it -- which is how a dependency
# nobody needs quietly becomes one nobody can remove.

[Service]
Type=simple

# CHANGE THIS to whoever owns /opt/fivem-server-classic. Check with `whoami`.
# Running the game server as root is a needless risk: it is the process most
# exposed to the public internet on this box.
User=ubuntu
Group=ubuntu

WorkingDirectory=/opt/fivem-server-classic

# `exec` so bash replaces itself with FXServer rather than lingering as a
# parent systemd would have to signal through -- that way systemd's stop and
# restart reach the real process.
#
# `< <(sleep infinity)` is the stdin-never-EOFs trick described above. Without
# it this boot-loops. It needs bash rather than sh -- process substitution is
# not POSIX -- which is the other reason ExecStart goes through a shell.
ExecStart=/bin/bash -c 'exec ./run.sh +exec server.cfg < <(sleep infinity)'

Restart=always
RestartSec=10

# Do not give up. The default is 5 restarts in 10s before systemd marks the
# unit failed and stops trying, which is exactly the wrong behaviour for a game
# server that crash-loops at 3am -- it would stay down until someone noticed.
StartLimitIntervalSec=0

# FXServer holds a socket per player plus its own file handles. The default
# 1024 is comfortable at 48 players and not at the 2048 this is heading for.
LimitNOFILE=65536

# Stopping: FXServer handles SIGTERM and needs a moment to close out cleanly.
KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=royale

[Install]
WantedBy=multi-user.target
