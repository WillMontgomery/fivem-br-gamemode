# FiveM Royale -- systemd unit. FXServer runs inside a tmux session.
#
#   sudo apt install -y tmux
#   sudo cp tools/royale.service /etc/systemd/system/royale.service
#   sudo cp tools/royale-watchdog.service tools/royale-watchdog.timer /etc/systemd/system/
#   sudo nano /etc/systemd/system/royale.service     # set User= and the paths
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now royale royale-watchdog.timer
#
# WHY TMUX IS LOAD-BEARING AND NOT A PREFERENCE. This artifact does not run
# without a real terminal, and we know because we tried everything short of one:
#
#   1. Plain unit: systemd hands the process a stdin already at EOF; FXServer
#      reads it as Ctrl-C and quits cleanly, two seconds into every boot.
#   2. Piped stdin (`< <(sleep infinity)`): survives boot, authenticates with
#      Nucleus -- then SIGABRTs seconds later, every time. A pipe is not a PTY.
#      This loop also masqueraded as "clients can't connect" for a whole
#      evening: the server was dead for most of every ten-second restart cycle,
#      and `ss` happened to catch it mid-boot, so "it is listening" and
#      "connection refused" were both true.
#
# The same content launched from a real terminal runs indefinitely. DEPLOY.md's
# old folklore ("segfaults when launched directly by systemd, run under tmux")
# was pointing at this all along -- ours aborts rather than segfaults, same
# family. So: systemd owns the lifecycle, tmux owns the terminal.
#
# WHAT THIS BUYS BEYOND SURVIVAL, and it is not nothing:
#   - `tmux attach -t royale` is a real interactive console again -- brprofile,
#     brstate, brperf all work without stopping the server. (Detach with
#     ctrl-b then d. NEVER ctrl-c, which kills the server.)
#   - `tmux send-keys` becomes a usable command channel, which is the cheap
#     stepping stone M9 Slice 2 wanted and thought it had lost.
#
# WHAT IT COSTS, and how each cost is paid:
#   - systemd cannot see a crash inside the session (tmux itself survives), so
#     Restart=always only covers tmux dying. royale-watchdog.timer covers the
#     rest: every 30s it checks the session exists and restarts this unit if
#     not.
#   - The journal gets nothing. pipe-pane below mirrors the console to
#     console.log next to the server. No rotation yet -- that is M9 9e's job;
#     until then it grows, which is a known cost and not a surprise.

[Unit]
Description=FiveM Royale (FXServer, in a tmux session)
Documentation=https://github.com/WillMontgomery/fivem-br-gamemode
After=network-online.target
Wants=network-online.target

[Service]
# -d detaches immediately, which is what makes Type=forking correct here.
Type=forking

# CHANGE THIS to whoever owns /opt/fivem-server-classic. Check with `whoami`.
# The tmux session belongs to this user, so `tmux attach -t royale` works from
# their shell with no sudo.
User=ubuntu
Group=ubuntu

WorkingDirectory=/opt/fivem-server-classic

# The session name `royale` is load-bearing: attach, the watchdog, the deploy
# advice and any future send-keys all address it. Do not rename it casually.
ExecStart=/usr/bin/tmux new-session -d -s royale './run.sh +exec server.cfg'

# Fail the unit if the session is not actually there a moment later, rather
# than reporting success for a server that died on startup.
ExecStartPost=/bin/sh -c 'sleep 5; /usr/bin/tmux has-session -t royale'

# Mirror the console into a file, since the journal cannot see inside tmux.
# `-` prefix: logging is not worth failing a boot over.
ExecStartPost=-/usr/bin/tmux pipe-pane -t royale -o 'cat >> /opt/fivem-server-classic/console.log'

# `-` prefix: when the watchdog restarts a unit whose session already died,
# kill-session on a missing session must not abort the restart.
ExecStop=-/usr/bin/tmux kill-session -t royale

Restart=always
RestartSec=10
# systemd's default gives up after five restarts in ten seconds, which is the
# wrong behaviour for a game server crash-looping at 3am.
StartLimitIntervalSec=0

# FXServer holds a socket per player plus its own file handles. The default
# 1024 is comfortable at 48 players and not at the 2048 this is heading for.
LimitNOFILE=65536

# tmux owns the game server process, not this unit's cgroup bookkeeping.
# Killing the cgroup would take the session down without the clean shutdown
# ExecStop exists to give.
KillMode=none
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
